# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase URL & Anon Key for offline-first SQLite synchronization
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Stripe API config for direct subscription verification
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_MONTHLY_PRICE_ID=price_monthly_placeholder
STRIPE_ANNUAL_PRICE_ID=price_annual_placeholder
